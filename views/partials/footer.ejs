<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-mark" aria-hidden="true"></span>
        <p class="footer-tagline"><%= site.footer || site.tagline %></p>
        <p class="footer-meta">© <%= new Date().getFullYear() %> <%= site.author.name %> · <%= site.title %> <%= site.titleEn %></p>
      </div>
      <div class="footer-col">
        <h4>导航</h4>
        <a href="/archive">归档</a>
        <a href="/about">关于我</a>
        <a href="/search">搜索</a>
      </div>
      <div class="footer-col">
        <h4>订阅</h4>
        <a href="/feed.xml">RSS 订阅</a>
        <a href="/sitemap.xml">站点地图</a>
        <a href="/search">站内搜索</a>
      </div>
      <div class="footer-col">
        <h4>联系</h4>
        <% if (site.author.links) { for (const [name, href] of Object.entries(site.author.links)) { %>
          <a href="<%= href %>" rel="noopener"><%= name %></a>
        <% } } %>
        <% if (site.author.email) { %>
          <a href="mailto:<%= site.author.email %>">邮件</a>
        <% } %>
      </div>
    </div>
  </div>
</footer>
<script type="module" src="/public/js/main.js?v=<%= assetVersion %>"></script>
