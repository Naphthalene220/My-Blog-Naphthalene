<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>图片管理 · <%= site.title %> 后台</title>
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
  <link rel="stylesheet" href="/public/css/main.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/public/css/admin.css?v=<%= assetVersion %>" />
</head>
<body class="admin">
  <header class="admin-topbar">
    <a class="brand admin-brand" href="/admin/posts">
      <span class="brand-mark" aria-hidden="true"><span></span></span>
      <span class="brand-text"><strong><%= site.title %></strong><em>ADMIN</em></span>
    </a>
    <nav class="admin-topnav">
      <a href="/" target="_blank" rel="noopener">查看站点 ↗</a>
      <a href="/admin/posts">文章管理</a>
      <a href="/admin/about">关于页</a>
      <a href="/admin/settings">设置</a>
      <form method="post" action="/admin/logout"><button class="linklike" type="submit">退出</button></form>
    </nav>
  </header>

  <main class="admin-main admin-single">
    <h1 class="admin-h1">图片管理</h1>
    <p class="admin-sub">共 <%= images.length %> 张图片。点「复制」可复制 Markdown 图片语法；「删除」会移除文件（不可恢复）。</p>

    <% if (!images.length) { %>
      <p class="muted">还没有图片，可在文章编辑器中上传。</p>
    <% } else { %>
      <div class="media-grid" id="media-grid">
        <% for (const img of images) { %>
          <div class="media-card" data-rel="<%= img.rel %>" data-url="<%= img.url %>">
            <div class="media-thumb"><img src="<%= img.url %>" alt="<%= img.name %>" loading="lazy" /></div>
            <div class="media-meta">
              <span class="media-name" title="<%= img.name %>"><%= img.name %></span>
              <span class="media-size"><%= (img.size / 1024).toFixed(1) %> KB</span>
            </div>
            <div class="media-actions">
              <button class="admin-ghost" type="button" data-act="copy">复制</button>
              <button class="admin-delete" type="button" data-act="delete">删除</button>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
    <span class="admin-status" id="status"></span>
  </main>

  <script type="module" src="/public/js/admin-media.js?v=<%= assetVersion %>"></script>
</body>
</html>
