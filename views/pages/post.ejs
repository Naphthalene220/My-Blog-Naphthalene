<!doctype html>
<html lang="<%= site.language %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <div class="post-layout">
      <article class="post">
        <header class="post-header">
          <div class="post-kicker">
            <time datetime="<%= post.dateISO %>"><%= post.dateFormatted %></time>
          </div>
          <h1 class="post-title"><%= post.title %></h1>
          <div class="post-meta">
            <span>约 <%= post.readingTime %> 分钟</span>
            <% if (post.tags && post.tags.length) { %>
              <span class="sep">·</span>
              <% for (const t of post.tags) { %><a class="tag" href="/archive?tag=<%= encodeURIComponent(t) %>">#<%= t %></a><% } %>
            <% } %>
          </div>
        </header>

        <% if (post.cover) { %>
          <figure class="post-cover"><img src="<%= post.cover %>" alt="<%= post.title %>" /></figure>
        <% } %>

        <div class="post-body typography"><%- post.html %></div>

        <nav class="post-nav">
          <div>
            <% if (prev) { %>
              <span class="post-nav-label">← 上一篇</span>
              <a href="/posts/<%= prev.slug %>"><%= prev.title %></a>
            <% } %>
          </div>
          <div class="post-nav-next">
            <% if (next) { %>
              <span class="post-nav-label">下一篇 →</span>
              <a href="/posts/<%= next.slug %>"><%= next.title %></a>
            <% } %>
          </div>
        </nav>
      </article>

      <aside class="post-toc" id="post-toc">
        <div class="toc-sticky">
          <div class="toc-head">
            <h4 class="toc-title">目录</h4>
            <span class="toc-progress" id="toc-progress">0%</span>
          </div>
          <nav class="toc-nav" id="toc-nav"></nav>
        </div>
      </aside>
    </div>
  </main>

  <div class="read-progress" id="read-progress" aria-hidden="true">
    <span id="read-progress-bar"></span>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
